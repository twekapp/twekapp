{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/[...path].js": {
      "runtime": "nodejs22.x",
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  }
}
