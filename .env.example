# Frontend — Privy dashboard
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# X API v2 app-only bearer (Developer portal → app → Keys). Not Privy Twitter login.
# 1 = live $RYIOT search. off = pause (no credit spend).
X_PULL=1
X_PULL_MAX=10
X_PULL_MINUTES=30
X_BEARER_TOKEN=

# Supabase (server only). URL = Project URL. Key = service_role, not anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Board + Payment Dev unlock. Generate a long random string.
RYIOT_ADMIN_KEY=

# Hourly USD pool. Dust under 0.50 is skipped.
RYIOT_POOL_USD=50

# Set 1 on HTTPS production.
# RYIOT_COOKIE_SECURE=1
